# ==============================================================================
# PREMIXTRACK ENTERPRISE - FILE CẤU HÌNH MẪU (.env.example)
# ==============================================================================
# Hướng dẫn: 
# 1. Sao chép nội dung file này vào file .env
# 2. Điền thông tin mật khẩu DB_PASSWORD thực tế của MS SQL Server
# ==============================================================================

# ==========================================
# 1. CẤU HÌNH GEMINI AI (GOOGLE CLOUD)
# ==========================================
# Khóa API để sử dụng tính năng Chuyên gia Cố vấn AI Chuỗi Cung Ứng
GEMINI_API_KEY="AIzaSyAiUi4xYXTHpb6Xu1PVszD_aOKkzag7hpo"

# ==========================================
# 2. CẤU HÌNH AI LOCAL TRÊN LAPTOP Y410P (OLLAMA / OCR)
# ==========================================
# Địa chỉ IP máy tính trạm Y410p chạy Ollama trong mạng LAN nội bộ
OLLAMA_HOST="http://192.168.1.222:11434"
OLLAMA_MODEL="qwen2.5:3b"
OLLAMA_TIMEOUT_MS=180000

# ==========================================
# 3. CẤU HÌNH MS SQL SERVER 2022 (LXC 102)
# ==========================================
# Địa chỉ IP của Container/Máy chủ SQL Server trong mạng nội bộ
DB_SERVER=192.168.1.202
DB_PORT=1433
DB_USER=sa
# Điền mật khẩu tài khoản sa của MS SQL Server tại đây:
DB_PASSWORD=your_actual_password_here
DB_NAME=PremixTrackDB
# Đặt false nếu chạy trong mạng nội bộ chưa cài SSL certificate cho SQL
DB_ENCRYPT=false

# ==========================================
# 4. CẤU HÌNH ỨNG DỤNG WEB (PREMIXTRACK APP)
# ==========================================
PORT=3000
NODE_ENV="development"
